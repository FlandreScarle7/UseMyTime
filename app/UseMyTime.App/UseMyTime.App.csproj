<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UseMyTime.App</RootNamespace>
    <AssemblyName>UseMyTime</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;AnyCPU</Platforms>
    <Version>1.0.0</Version>
    <Authors>UseMyTime</Authors>
    <Product>UseMyTime</Product>
    <Description>Per-process Windows time hijacking tool</Description>
  </PropertyGroup>

  <!-- 将编译好的 C++ hook DLL 复制到输出目录 -->
  <ItemGroup>
    <None Include="..\..\native\bin\x64\Release\UseMyTimeHook.dll"
          Condition="Exists('..\..\native\bin\x64\Release\UseMyTimeHook.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>UseMyTimeHook.dll</Link>
    </None>
  </ItemGroup>

</Project>
